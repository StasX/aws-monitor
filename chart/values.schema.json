{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AWS Monitor Helm values",
  "type": "object",
  "required": [
    "app",
    "pod",
    "replicas",
    "mongodb"
  ],
  "properties": {
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "awsRegion",
        "cacheTtl",
        "refreshTimeout",
        "failureCooldown",
        "taskTimeout",
        "maxDataAge",
        "workers",
        "threads"
      ],
      "properties": {
        "awsRegion": {
          "type": "string",
          "minLength": 1
        },
        "cacheTtl": {
          "type": "number",
          "minimum": 0,
          "maximum": 86400
        },
        "refreshTimeout": {
          "type": "number",
          "minimum": 0,
          "maximum": 30
        },
        "failureCooldown": {
          "type": "number",
          "minimum": 0,
          "maximum": 3600
        },
        "taskTimeout": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 300
        },
        "maxDataAge": {
          "type": "number",
          "minimum": 1,
          "maximum": 86400
        },
        "workers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "threads": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      }
    },
    "pod": {
      "type": "object",
      "required": [
        "port",
        "targetPort"
      ],
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "targetPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "replicas": {
      "type": "integer",
      "minimum": 1
    },
    "dashboard": {
      "type": "object",
      "required": [
        "maxFailures",
        "windowSeconds"
      ],
      "additionalProperties": false,
      "properties": {
        "maxFailures": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "windowSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      }
    },
    "mongodb": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "existingSecret",
        "database"
      ],
      "properties": {
        "existingSecret": {
          "type": "string",
          "minLength": 1
        },
        "database": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      }
    }
  }
}
